# Copy this file to .env and fill in from Supabase > Project Settings > API
# Until the first two exist, the site runs in demo mode with local photos.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server-side ONLY — used by scripts/seed.mjs, never shipped to the browser.
# From Supabase > Project Settings > API Keys > service_role (secret).
# NEVER commit this or add it to Vercel.
SUPABASE_SERVICE_ROLE_KEY=
